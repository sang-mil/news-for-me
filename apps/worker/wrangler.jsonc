{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "news-for-me-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-02",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGIN": "http://127.0.0.1:5173,http://localhost:5173,https://news-for-me.pages.dev",
    "BETTER_AUTH_URL": "https://news-for-me.pages.dev",
    "GEMINI_MODEL_PRIMARY": "gemini-3.8-flash",
    "GEMINI_MODEL_FALLBACK": "gemini-3.5-flash-lite",
    "OPENROUTER_MODEL": "openrouter/free",
    "OPENROUTER_ALLOW_PAID": "false",
    "OPENROUTER_SITE_URL": "https://news-for-me.pages.dev",
    "OPENROUTER_APP_TITLE": "News for Me"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "news-for-me-db",
      "database_id": "1828de37-71bf-400c-a4fd-363cebbcd93f",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "NEWS_QUEUE",
        "queue": "news-for-me-collection"
      }
    ],
    "consumers": [
      {
        "queue": "news-for-me-collection",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "news-for-me-collection-dlq"
      },
      {
        "queue": "news-for-me-collection-dlq",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_retries": 3
      }
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *",
      "0 23 * * *",
      "0 15 * * SUN",
      "0 * * * *"
    ]
  },
  "workers_dev": false
}

