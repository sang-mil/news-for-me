# Add the real values to apps/worker/.dev.vars, not to this example file.
# Generate a persistent 32-byte key, Base64-encode it, and keep it private.
# The same key is required to decrypt previously saved per-user API credentials.
INTEGRATION_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Local-only identity (keep your current user ID to preserve local data).
DEV_USER_ID=your-existing-local-user-id
DEV_USER_EMAIL=your-local-email
ALLOW_DEV_AUTH=true
ALLOWED_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
GEMINI_API_KEY_1=your-gemini-api-key-1
GEMINI_API_KEY_2=your-gemini-api-key-2

# Same label if both keys are from the same Google Cloud project.
# Different labels only if they are genuinely separate projects.
GEMINI_PROJECT_SLOT_1=google-project-a
GEMINI_PROJECT_SLOT_2=google-project-b

GEMINI_MODEL_PRIMARY=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite

# Optional: YouTube Data API v3 key (one search.list call per topic collection).
YOUTUBE_API_KEY=your-youtube-data-api-key

# Optional: X API pay-per-use bearer token. Posts are billed per item returned.
X_BEARER_TOKEN=your-x-api-bearer-token

# Optional: Meta Threads API user access token (requires keyword search permission).
THREADS_ACCESS_TOKEN=your-threads-access-token

OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_ALLOW_PAID=false
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_TITLE=News for Me

# Google OAuth: use the same Google OAuth client for the app sign-in and Gmail sender.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Better Auth session. Verified Google accounts can create separate app users.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://127.0.0.1:8787
# Preserve the current News for Me data owner on first Google login.
LEGACY_USER_ID=your-existing-DEV_USER_ID

# Gmail API sending remains a server-level sender integration for now.
GOOGLE_REFRESH_TOKEN=your-gmail-refresh-token
GMAIL_SENDER=your-google-login-email

